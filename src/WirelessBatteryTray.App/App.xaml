<Application x:Class="WirelessBatteryTray.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:app="clr-namespace:WirelessBatteryTray.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MDIX 5.x：BundledTheme 提供主题色，MaterialDesign2.Defaults 提供全部控件样式。
                     注意顺序：Defaults 之后才能被我们自己的色板覆盖基础色。 -->
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Blue"
                                             SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

                <!-- 本应用语义色板（索引 2，ThemeManager 切换此槽位） -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/DeviceIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <app:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <app:ResourceKeyConverter x:Key="ResourceKey" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
