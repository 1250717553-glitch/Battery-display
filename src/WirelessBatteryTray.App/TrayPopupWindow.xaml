<Window x:Class="WirelessBatteryTray.App.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="快捷面板"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <!-- 单个设备磁贴：横向紧凑布局 -->
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <materialDesign:Card x:Name="Tile"
                                             UniformCornerRadius="10"
                                             Padding="12,10"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <ContentPresenter />
                        </materialDesign:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile"
                                        Property="materialDesign:ElevationAssist.Elevation"
                                        Value="Dp3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层：圆角 12 + 阴影 -->
    <Border Margin="10" CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            MaxWidth="620">
        <Border.Effect>
            <DynamicResource ResourceKey="CardShadow" />
        </Border.Effect>

        <StackPanel>
            <!-- 顶部：标题 + 设备数 -->
            <Grid Margin="16,12,16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BatteryCharging" Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock x:Name="HeaderText" Text="在线设备" Margin="6,0,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleForegroundBrush}" />
                </StackPanel>

                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Width="26" Height="26" Padding="0"
                        HorizontalAlignment="Right"
                        Click="OnOpenMainClick" ToolTip="打开完整窗口">
                    <materialDesign:PackIcon Kind="ArrowExpand" Width="14" Height="14"
                                             Foreground="{DynamicResource SubtleForegroundBrush}" />
                </Button>
            </Grid>

            <!-- 设备磁贴区（横向） -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="16,0,8,0">
                <ItemsControl x:Name="TileHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileStyle}" Click="OnTileClick">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标 -->
                                    <Border Width="34" Height="34" CornerRadius="9"
                                            Background="{DynamicResource IconBackdropBrush}"
                                            VerticalAlignment="Center">
                                        <Path Data="{Binding KindIcon, Converter={StaticResource ResourceKey}}"
                                              Fill="{DynamicResource IconForegroundBrush}"
                                              Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 名称 + 电量 -->
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="72">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   MaxWidth="120"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Text="{Binding PercentText}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Margin="0,1,0,0"
                                                   Foreground="{Binding PercentBrushKey, Converter={StaticResource ResourceKey}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <TextBlock x:Name="EmptyHint" Text="暂无在线设备"
                       Margin="16,10,16,14" FontSize="12.5"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Visibility="Collapsed" />

            <!-- 底部提示 -->
            <TextBlock Text="点击任意设备打开完整窗口 · 点击别处关闭"
                       Margin="16,8,16,12" FontSize="10.5"
                       Foreground="{DynamicResource SubtleForegroundBrush}" />
        </StackPanel>
    </Border>
</Window>
