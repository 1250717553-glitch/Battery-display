<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Win11 深色：窗口底近黑，卡片抬高一档形成层次 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2F2F2F" />
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#FF33445A" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FF2F2F2F" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#FF33445A" />

    <SolidColorBrush x:Key="TierLowBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="TierMediumBrush" Color="#FFF0C64B" />
    <SolidColorBrush x:Key="TierHighBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="TierNoneBrush" Color="#FF9A9A9A" />

    <SolidColorBrush x:Key="AlertBrush" Color="#FFFF6B6B" />

    <SolidColorBrush x:Key="OnlineDotBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="OfflineDotBrush" Color="#FF666666" />

    <SolidColorBrush x:Key="IconBackdropBrush" Color="#FF32383F" />
    <SolidColorBrush x:Key="IconForegroundBrush" Color="#FF8AB4F8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF3A3A3A" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Direction="270"
                      Color="#FF000000" Opacity="0.45" />
</ResourceDictionary>
