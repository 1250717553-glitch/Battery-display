<Window x:Class="WirelessBatteryTray.App.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="无线设备电量"
        MinHeight="320" MinWidth="480"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource ForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DeviceCardStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <materialDesign:Card x:Name="Card"
                                             UniformCornerRadius="12"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </materialDesign:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="materialDesign:ElevationAssist.Elevation"
                                        Value="Dp3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card"
                                        Property="materialDesign:ElevationAssist.Elevation"
                                        Value="Dp4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="14"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DynamicResource ResourceKey="CardShadow" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="46" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BatteryCharging" Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="无线设备电量" Margin="8,0,0,0" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleForegroundBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34"
                            Click="OnToggleSettings" ToolTip="报警设置"
                            Foreground="{DynamicResource SubtleForegroundBrush}">
                        <materialDesign:PackIcon Kind="Cog" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34"
                            Click="OnCloseClick" ToolTip="关闭"
                            Foreground="{DynamicResource SubtleForegroundBrush}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLine" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Text="正在读取设备…" />
                    <TextBlock x:Name="SubStatusLine" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               Text="打开时主动读取一次，其余时间用缓存" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                        x:Name="RefreshButton" Width="40" Height="40"
                        Click="OnRefreshClick" ToolTip="立即刷新"
                        Foreground="{DynamicResource PrimaryHueMidBrush}">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>
            </Grid>

            <ListBox x:Name="DeviceList" Grid.Row="2"
                     Margin="20,0,20,0"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource DeviceCardStyle}"
                     MouseDoubleClick="OnGridDoubleClick"
                     PreviewKeyDown="OnGridKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                                    Background="{DynamicResource IconBackdropBrush}"
                                    VerticalAlignment="Center">
                                <Path Data="{Binding KindIcon, Converter={StaticResource ResourceKey}}"
                                      Fill="{DynamicResource IconForegroundBrush}"
                                      Width="24" Height="24" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                            Background="{DynamicResource IconBackdropBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="过期" FontSize="10.5"
                                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <Grid Margin="0,10,0,0" Height="4" Width="200"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}">
                                    <Border CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                                    <Border CornerRadius="2" HorizontalAlignment="Left"
                                            Background="{Binding PercentBrushKey, Converter={StaticResource ResourceKey}}"
                                            Width="{Binding LevelWidth}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right" MinWidth="118">
                                <TextBlock Text="{Binding PercentText}"
                                           FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Foreground="{Binding PercentBrushKey, Converter={StaticResource ResourceKey}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource OfflineDotBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource OnlineDotBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubtleForegroundBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重命名…" Click="OnRenameClick" />
                        <MenuItem Header="恢复系统名" Click="OnResetNameClick" />
                        <Separator />
                        <MenuItem Header="刷新" Click="OnRefreshClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- ===== 报警设置（默认收起）===== -->
            <materialDesign:Card Grid.Row="3" x:Name="SettingsPanel"
                                 Margin="20,4,20,8" Padding="16,14"
                                 UniformCornerRadius="12"
                                 materialDesign:ElevationAssist.Elevation="Dp2"
                                 Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="低电量报警" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="在线设备的真实电量跌破阈值时提醒一次；回升到重置值以上后才会再次提醒。"
                               FontSize="11" Margin="0,3,0,12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubtleForegroundBrush}" />

                    <!-- 报警阈值 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="报警阈值" FontSize="12"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="电量低于此值时报警" FontSize="10.5"
                                       Foreground="{DynamicResource SubtleForegroundBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="LowThresholdSlider" Width="140" Minimum="1" Maximum="99"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnThresholdChanged" />
                            <TextBlock x:Name="LowThresholdText" Width="42" FontSize="12"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 重置阈值 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="重置阈值" FontSize="12"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="电量回升到此值以上才允许再次报警" FontSize="10.5"
                                       Foreground="{DynamicResource SubtleForegroundBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="ResetThresholdSlider" Width="140" Minimum="2" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnThresholdChanged" />
                            <TextBlock x:Name="ResetThresholdText" Width="42" FontSize="12"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 提示音开关 -->
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="提示音" FontSize="12"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="关闭后仍会变红，但不再播放声音" FontSize="10.5"
                                       Foreground="{DynamicResource SubtleForegroundBrush}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="SoundToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="试听" Margin="0,0,8,0" Height="30" Padding="14,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnTestSound" />
                        <Button Content="保存" Height="30" Padding="16,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="OnSaveSettings" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <TextBlock Grid.Row="4" Margin="20,14,20,16" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Text="双击可重命名 · 别名按设备身份保存，重连后仍然有效 · 读不到电量显示「未知」，绝不显示 0%" />
        </Grid>
    </Border>
</Window>
