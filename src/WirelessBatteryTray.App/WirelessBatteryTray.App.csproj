    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WirelessBatteryTray.App</AssemblyName>
    <RootNamespace>WirelessBatteryTray.App</RootNamespace>
  </PropertyGroup>

</Project>
